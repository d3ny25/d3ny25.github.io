---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

type BlogPost = {
  slug: string;
  data: {
    title: string;
    description: string;
    pubDate: Date;
    image?: string;
  };
};

const posts = (await getCollection("blog"))
  .sort(
    (a: BlogPost, b: BlogPost) =>
      b.data.pubDate.getTime() - a.data.pubDate.getTime()
  );
---
<Layout>
<head>
  <meta charset="utf-8" />
</head>

<section class="py-24 text-center max-w-4xl mx-auto">
  <h1 class="text-5xl font-extrabold text-indigo-400 mb-4">
    Blog
  </h1>

  <p class="text-gray-400 text-lg leading-relaxed">
    Artículos sobre mi vida
  </p>
</section>

<section class="max-w-6xl mx-auto px-6 pb-24">
  <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {posts.map((post: BlogPost) => (
      <a
        href={`/blog/${post.slug}`}
        class="group bg-gray-900 border border-gray-800 rounded-2xl overflow-hidden
               hover:shadow-lg hover:shadow-indigo-500/10 transition-all duration-300"
      >
        {post.data.image && (
          <img
            src={post.data.image}
            alt={post.data.title}
            class="h-48 w-full object-cover group-hover:scale-105 transition-transform duration-300"
          />
        )}

        

        <div class="p-6 flex flex-col h-full">
          <h2 class="text-xl font-bold text-indigo-300 mb-2 group-hover:text-indigo-400">
            {post.data.title}
          </h2>

          <p class="text-gray-400 text-sm leading-relaxed line-clamp-3 mb-4">
            {post.data.description}
          </p>

          <div class="mt-auto flex items-center justify-between text-sm text-gray-500">
            <span>
              {post.data.pubDate.toLocaleDateString("es-MX")}
            </span>

            <span class="text-indigo-400 font-semibold">
              Leer →
            </span>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
</Layout>